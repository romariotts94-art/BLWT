{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blwt-npd-daily-check",
  "main": "workers/npd-scheduler.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blwt-production",
      "database_id": "07df0093-7a08-47e8-8019-9b18feb11ce4"
    }
  ],
  "observability": { "enabled": true }
}