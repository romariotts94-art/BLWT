NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=https://example.ru

# PostgreSQL on the same VPS for the initial low-cost setup.
DATABASE_URL=postgres://blwt:replace-with-long-random-password@db:5432/blwt
POSTGRES_PASSWORD=replace-with-same-long-random-password
PG_POOL_SIZE=10
PG_SSL=false

# Generate a long random value and keep this file private on the server.
AUTH_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAILS=owner@example.ru

# SMTP account on a domain you control; never commit the real credentials.
SMTP_HOST=smtp.example.ru
SMTP_PORT=465
SMTP_USER=site@example.ru
SMTP_PASSWORD=replace-me
AUTH_FROM=Black and White <site@example.ru>

# Persistent local folder mounted on the VPS.
FILE_STORAGE_PATH=/app/data/uploads

# Configure TURN credentials and domain after the VPS/domain are ready.
TURN_URLS=turn:example.ru:3478?transport=udp,turn:example.ru:3478?transport=tcp
TURN_USERNAME=replace-me
TURN_CREDENTIAL=replace-me
PUBLIC_DOMAIN=example.ru
PUBLIC_IP=203.0.113.10

# Optional: private support notifications. Keep the token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=-1001234567890
