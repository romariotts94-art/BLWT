# Copy to .env.vtb-stage, chmod 600, and fill the private values there.
# Use this file only with compose.vtb-stage.yml. Never use production credentials.
VTB_STAGE_POSTGRES_PASSWORD=replace-with-long-random-password
# URL-encode reserved characters in the password in this URL.
VTB_STAGE_DATABASE_URL=postgres://blwt_vtb:replace-with-same-url-encoded-password@db:5432/blwt_vtb_qa
VTB_STAGE_AUTH_SECRET=replace-with-at-least-32-random-bytes
VTB_STAGE_ADMIN_EMAIL=developer-admin@blackandwhite.local
VTB_STAGE_USER_NAME=replace-with-vtb-sandbox-api-login
VTB_STAGE_PASSWORD=replace-with-vtb-sandbox-api-password
# Absolute path to the private root + intermediate Ministry of Digital Development CA bundle.
VTB_STAGE_CA_BUNDLE_PATH=/absolute/private/path/vtb-ca-bundle.pem
VTB_STAGE_RELEASE_SHA=replace-with-git-commit-sha
VTB_STAGE_IMAGE_TAG=local
VTB_STAGE_PORT=5176
VTB_STAGE_MAIL_UI_PORT=8026
VTB_STAGE_PUBLIC_ORIGIN=http://127.0.0.1:5176
VTB_STAGE_RETURN_ORIGIN=http://127.0.0.1:5176
