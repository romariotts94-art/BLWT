www.blackandwhite-mos.ru {
  redir https://blackandwhite-mos.ru{uri} permanent
}

www.blacktowhite.ru {
  redir https://blacktowhite.ru{uri} permanent
}

blackandwhite-mos.ru, blacktowhite.ru {
  encode gzip zstd
  handle /media/* {
    root * /srv/black-and-white
    file_server
  }
  handle {
    reverse_proxy app:3000
  }
}
